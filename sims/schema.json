{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.ftd.aero/schemas/sim-config.json",
  "title": "FTD simulator configuration",
  "type": "object",
  "required": ["serial", "device_type", "qualification", "client", "manual", "components"],
  "additionalProperties": false,
  "properties": {
    "serial": { "type": "string", "description": "Manufacturer serial number, e.g. B73M/F2M/04/2026" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "URL-safe form of the serial, e.g. b73m-f2m-04-2026" },
    "device_type": { "type": "string" },
    "qualification": { "type": "string", "description": "e.g. FNPT II / MCC" },
    "client": { "type": "string" },
    "delivered": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "manual": {
      "type": "object",
      "required": ["template", "issue", "revision"],
      "additionalProperties": false,
      "properties": {
        "template": { "type": "string", "description": "Template id from templates/" },
        "issue": { "type": "integer", "minimum": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "effective_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$", "description": "Content hash of the last released revision. Written by tools/bump.js — never edit by hand." }
      }
    },
    "components": {
      "type": "object",
      "description": "Keyed by component id. Omitted components are treated as not installed.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "installed": { "type": "boolean", "default": true },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
