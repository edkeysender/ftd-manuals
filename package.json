{
  "name": "ftd-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "node --max-old-space-size=6144 ./node_modules/@docusaurus/core/bin/docusaurus.mjs start",
    "build": "node --max-old-space-size=6144 ./node_modules/@docusaurus/core/bin/docusaurus.mjs build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "resolve": "node tools/resolve.js --all",
    "resolve:strict": "node tools/resolve.js --all --strict",
    "bump": "node tools/bump.js",
    "bump:check": "node tools/bump.js --check",
    "admin": "node tools/admin-server.js",
    "prebuild": "node tools/resolve.js --all",
    "prestart": "node tools/resolve.js --all"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "ajv": "^8.20.0",
    "clsx": "^2.0.0",
    "js-yaml": "^5.4.1",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
